<idea-plugin>
    <id>app.oreshkov.kmp.wizard</id>
    <name>KMP Project Wizard</name>
    <!-- <vendor>, <name>, <description>, <version> and <change-notes> are injected at
         build time by intellijPlatform.pluginConfiguration in build.gradle.kts (the single
         source of truth, fed from gradle.properties). Don't duplicate <vendor> here. -->

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>com.intellij.gradle</depends>

    <!-- Android Studio replaces the platform's New Project dialog with its own NPW at
         startup (android-npw-androidstudio.xml -> NewProjectActionsInitializer), and that
         dialog never enumerates com.intellij.newProjectWizard.generator — so the generator
         below is unreachable there. The Studio-side entry point is the Android plugin's
         com.android.tools.idea.wizard.template EP, registered in the optional descriptor.
         Gated on org.jetbrains.android rather than com.intellij.modules.androidstudio,
         matching JetBrains' own Kotlin Multiplatform plugin: the extension point is
         declared in android-plugin.xml (the Android plugin's unconditional descriptor),
         so it also exists in IntelliJ IDEA whenever the Android plugin is installed.
         Filename follows the required <pluginId>-$NAME$.xml pattern. -->
    <depends optional="true" config-file="app.oreshkov.kmp.wizard-android.xml">org.jetbrains.android</depends>

    <resource-bundle>messages.KMPWizardBundle</resource-bundle>

    <!-- Freemium: the plugin installs and runs for free; the Pro tier (agent + CI
         scaffolding) is gated via LicensingFacade. release-version + release-date identify
         the licensable release and drive license-expiry / perpetual-fallback windows.
         Marketplace rules (docs/marketplace/versioning-of-paid-plugins): release-version is
         an integer split into two numbers where the SECOND is a single digit (20211 -> 2021,
         1), and those encode the plugin's major.minor — so for 1.7.x the only valid value is
         17 -> (1, 7). It must be non-descending. Official best practice: "when we upload any
         minor updates, we keep the release-version untouched and only increment the version";
         the Marketplace also rejects reusing a release-version with a DIFFERENT release-date.
         So every patch release in the 1.7 line keeps BOTH 17 and 20260728 from 1.7.0 —
         only pluginVersion changes. Bump these (to 18 + a new date) only at the next minor,
         1.8.0. The verifyProductDescriptor Gradle task (wired into `check`) enforces the
         release-version ↔ pluginVersion match, so a forgotten bump fails the build. -->
    <product-descriptor code="PKMPPROJECTWIZA"
                        release-date="20260905"
                        release-version="19"
                        optional="true"/>

    <extensions defaultExtensionNs="com.intellij">
        <newProjectWizard.generator
                implementation="app.oreshkov.kmp.wizard.KMPProjectWizard"/>

        <notificationGroup id="app.oreshkov.kmp.wizard.notifications"
                           displayType="BALLOON"
                           bundle="messages.KMPWizardBundle"
                           key="notification.group.name"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true" />
    </extensions>
</idea-plugin>